# libSQL / Turso. Default is a local file database.
DATABASE_URL=file:./data/app.db
# Only needed for remote Turso databases
DATABASE_AUTH_TOKEN=

# OPTIONAL — offline ingestion only. NEVER used on the runtime answer path.
ANTHROPIC_API_KEY=
# OPTIONAL — offline transcription only.
OPENAI_API_KEY=
# OPTIONAL — offline audio pre-generation only (scripts/generate-audio.mjs).
ELEVENLABS_API_KEY=

# --- 3D persona pipeline. All OPTIONAL and none on the answer path. ---
# Credential proxy. When set, the web app holds only this key and Daytona holds
# the rest. See daytona/README.md.
DAYTONA_API_URL=
DAYTONA_API_KEY=

# Speech + lip-sync timings in one call. Needs a consented voice_id per creator.
# ELEVENLABS_API_KEY is already declared above.

# Photo -> rigged GLB. Pick one; AVATAR_PROVIDER decides when both are present.
# Ready Player Me shut down, so this is pluggable by design. With none of these
# you can still set a model URL directly at /creator/[slug]/persona.
AVATAR_PROVIDER=
AVATURN_API_KEY=
DIDIMO_API_KEY=

# Allow live synthesis for lines that were never pre-generated. Off by default,
# so the demo path makes no external call. Pre-generate with:
#   npm run generate-persona
PERSONA_LIVE=
