# libSQL / Turso. Default is a local file database.
DATABASE_URL=file:./data/app.db
# Only needed for remote Turso databases
DATABASE_AUTH_TOKEN=

# OPTIONAL — offline ingestion only. NEVER used on the runtime answer path.
ANTHROPIC_API_KEY=
# OPTIONAL — offline transcription only.
OPENAI_API_KEY=
# OPTIONAL — offline audio pre-generation only (scripts/generate-audio.mjs).
ELEVENLABS_API_KEY=
